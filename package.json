{
  "name": "dsh-konata-humm",
  "version": "1.2.4",
  "private": true,
  "description": "模型在思考过程中发出 humm……时播放泉此方怪叫。",
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "bundle.patch.yml",
    "README.md",
    "build/konata-humm.wav",
